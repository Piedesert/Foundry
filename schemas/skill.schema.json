{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/skill.schema.json",
  "title": "SkillManifest",
  "description": "Schema for universal, reusable skill definitions",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "description",
    "purpose",
    "procedure",
    "constraints",
    "expected_output"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "applicability": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "action": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expected_output": {
      "type": "object",
      "required": ["format", "description"],
      "properties": {
        "format": { "type": "string" },
        "description": { "type": "string" },
        "schema_ref": { "type": "string" }
      }
    },
    "failure_behavior": {
      "type": "object",
      "properties": {
        "on_missing_input": { "type": "string" },
        "on_ambiguity": { "type": "string" },
        "on_tool_failure": { "type": "string" }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "input", "expected_result"],
        "properties": {
          "title": { "type": "string" },
          "input": { "type": "string" },
          "expected_result": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
