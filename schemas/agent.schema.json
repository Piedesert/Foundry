{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/agent.schema.json",
  "title": "AgentManifest",
  "description": "Schema for universal specialized agent definitions",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "description",
    "purpose",
    "skills",
    "inputs",
    "outputs",
    "tool_policy",
    "behavior"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "purpose": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "non_goals": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "type": "string", "enum": ["object"] },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": { "type": "object" }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "type": "string", "enum": ["object"] },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": { "type": "object" }
      }
    },
    "tool_policy": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approval_required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": ["iteration_limit", "must_validate", "must_report_blockers"],
      "properties": {
        "iteration_limit": { "type": "integer", "minimum": 1, "maximum": 10 },
        "must_validate": { "type": "boolean" },
        "must_report_blockers": { "type": "boolean" },
        "must_preserve_unrelated_changes": { "type": "boolean" }
      }
    },
    "model_preferences": {
      "type": "object",
      "properties": {
        "preferred_reasoning": { "type": "string", "enum": ["low", "medium", "high"] },
        "context_tier": { "type": "string", "enum": ["default", "long_context"] }
      }
    }
  },
  "additionalProperties": false
}
