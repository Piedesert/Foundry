{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/fitness-resource.schema.json",
  "title": "FitnessResource",
  "type": "object",
  "required": ["resource_id", "source_type", "title", "content"],
  "properties": {
    "resource_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["pdf", "article", "book", "training_note", "progress_log", "web_link", "other"]
    },
    "title": { "type": "string", "minLength": 1 },
    "author_or_owner": { "type": "string" },
    "locator": { "type": "string" },
    "content": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
    "is_user_specific": { "type": "boolean" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
