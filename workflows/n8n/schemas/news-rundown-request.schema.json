{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/news-rundown-request.schema.json",
  "title": "NewsRundownRequest",
  "type": "object",
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_stories": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    },
    "source_urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "since": { "type": "string" }
  },
  "additionalProperties": false
}
