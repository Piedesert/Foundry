{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/news-rundown-result.schema.json",
  "title": "NewsRundownResult",
  "type": "object",
  "required": ["status", "summary", "stories", "sources"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "blocked", "failure"]
    },
    "summary": { "type": "string" },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["headline", "url", "publisher", "relevance", "summary"],
        "properties": {
          "headline": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "published_at": { "type": "string" },
          "relevance": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
