{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/finance-paper-trade-result.schema.json",
  "title": "FinancePaperTradeResult",
  "type": "object",
  "required": ["status", "record_id", "message", "warnings"],
