{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-system.local/finance-analysis-result.schema.json",
  "title": "FinanceAnalysisResult",
  "type": "object",
  "required": [
    "status",
    "as_of",
    "summary",
    "facts",
    "signals",
    "trade_scenarios",
    "risk_assessment",
    "sources",
    "limitations",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["success", "partial", "blocked", "failure"] },
    "as_of": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "source_ids"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "bias", "time_horizon", "thesis", "trigger", "invalidation", "confidence"],
        "properties": {
          "symbol": { "type": "string" },
          "bias": { "type": "string", "enum": ["bullish", "bearish", "neutral", "monitor"] },
          "time_horizon": { "type": "string" },
          "thesis": { "type": "string" },
          "trigger": { "type": "string" },
          "invalidation": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "trade_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy", "rationale", "max_loss_usd", "max_gain_usd", "break_even_price", "key_risks", "source_ids"],
        "properties": {
          "strategy": { "type": "string" },
          "rationale": { "type": "string" },
          "max_loss_usd": { "type": ["number", "null"], "minimum": 0 },
          "max_gain_usd": { "type": ["number", "null"], "minimum": 0 },
          "break_even_price": { "type": ["number", "null"], "minimum": 0 },
          "key_risks": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": ["within_user_limits", "assumptions", "worst_case"],
      "properties": {
        "within_user_limits": { "type": ["boolean", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "worst_case": { "type": "string" },
        "maximum_loss_usd": { "type": ["number", "null"], "minimum": 0 },
        "user_limit_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_url", "retrieved_at"],
        "properties": {
          "source_id": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "published_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
